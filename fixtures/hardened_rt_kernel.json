{
  "profile_name": "hardened-tegra234-preempt-rt",
  "soc": "tegra234",
  "kernel_version": "6.6.21-rt26-tegra",
  "CONFIG_PREEMPT_RT": "y",
  "preempt_mode": "full",
  "sched_rt_runtime_us": 950000,
  "sched_rt_period_us": 1000000,
  "max_latency_us": 18,
  "isolcpus": "2-7",
  "nohz_full": "2-7",
  "rcu_nocbs": "2-7",
  "CONFIG_IRQ_FORCED_THREADING": "y",
  "threadirqs": true,
  "cpufreq_governor": "performance",
  "max_cstate": 0,
  "vm_swappiness": 0,
  "numa_balancing_enabled": false,
  "CONFIG_HZ": 1000,
  "high_res_timers_enabled": true,
  "efi_runtime_enabled": false,
  "ras_daemon_irq_on_rt_cores": false,
  "hardware_watchdog_enabled": true,
  "rt_mutex_debug_verified": true
}
